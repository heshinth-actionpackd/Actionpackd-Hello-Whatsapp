# HTTP port. Railway injects PORT; locally the default is 3000.
PORT=3000

# Postgres connection string. `npm run dev` applies migrations on startup.
# For a Railway public URL, keep sslmode=require (see README).
DATABASE_URL=postgres://postgres:hello@localhost:5432/hello

# Actionpackd Messaging API key: apk_live_... or apk_test_...
# Test keys validate sends and fire webhooks, but nothing reaches WhatsApp.
ACTIONPACKD_API_KEY=apk_test_replace_me

# Returned once by PUT /v1/webhook (or when rotate_secret is true).
ACTIONPACKD_WEBHOOK_SECRET=replace_me

# Optional. Defaults to https://api.actionpackd.com/v1
ACTIONPACKD_BASE_URL=https://api.actionpackd.com/v1

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me

# Optional. Defaults to gemini-3.5-flash-lite (AI Studio free tier: 15 RPM / 500 RPD / 250K TPM).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. How many user turns to replay. Defaults to 20.
# GEMINI_HISTORY_TURNS=20

# Digits of the WhatsApp number that receives handoff alerts and can send BOT ON.
TEAM_WHATSAPP_NUMBER=919800000000

# Optional: development | test | production. Defaults to development.
# NODE_ENV=development

# Optional pino level: fatal | error | warn | info | debug | trace | silent.
# LOG_LEVEL=info
